[Unit]
Description=gta6spot: next article -> vertical video in Dzen channel gta6info, one per run
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/root/dzen-autopost
Environment=PATH=/root/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/usr/bin/flock -n /run/dzen-video.lock /usr/bin/node /root/dzen-autopost/gta6spot.mjs --video
TimeoutStartSec=40min
